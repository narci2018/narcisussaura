{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NarcissusAura",
  "version": "0.2.16",
  "identifier": "com.narcissus.aura",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Narci'ssus Aura",
        "width": 940,
        "height": 660,
        "minWidth": 840,
        "minHeight": 580,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "binaries/*",
      "binaries/rules/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
